"1"><mxGeometry x="50" y="790" width="840" height="20" as="geometry"/></mxCell><mxCell id="c78" value="&lt;b&gt;Espresso tab&lt;/b&gt; (same layout, different fields)&lt;br&gt;Fields: Dose (g) 16–20 · Yield (g) · Shot time (s) · Grind (fine) · Taste · Rating · Notes&lt;br&gt;Target: 1:2 ratio (18 g in → 36 g out) · 25–30 s · log columns: # · Dose · Yield · Ratio · Time · Grind · Taste · Advice" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="50" y="820" width="840" height="80" as="geometry"/></mxCell><mxCell id="c79" value="&lt;b&gt;1 · Stock&lt;/b&gt;: each brew subtracts its dose. NEW BAG adds the bag size." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="950" y="152" width="260" height="80" as="geometry"/></mxCell><mxCell id="c80" value="&lt;b&gt;2 · Tabs&lt;/b&gt;: same coffee, two methods; each method has its own recipe." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="950" y="212" width="260" height="80" as="geometry"/></mxCell><mxCell id="c81" value="&lt;b&gt;3 · Prefill&lt;/b&gt;: dose and grind come from the last brew; hints show the targets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="950" y="326" width="260" height="90" as="geometry"/></mxCell><mxCell id="c82" value="&lt;b&gt;4 · Validation&lt;/b&gt;: wrong or missing values → message, nothing saved (422)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="950" y="426" width="260" height="80" as="geometry"/></mxCell><mxCell id="c83" value="&lt;b&gt;5 · Advice&lt;/b&gt;: one change per brew, with the reason (taste + time)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="950" y="592" width="260" height="70" as="geometry"/></mxCell><mxCell id="c84" value="&lt;b&gt;6 · Log&lt;/b&gt;: compare brews. Taste is written as a word, not shown by colour." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="950" y="686" width="260" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 · Screen states" id="p4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Screen states · parts of the coffee detail that change" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=18;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="-50" width="1200" height="24" as="geometry"/></mxCell><mxCell id="c2" value="Title = what happens · second line = trigger → API response" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="-22" width="1200" height="18" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;A · Missing input&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;LOG BREW without a taste → 422&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="420" height="32" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="420" height="270" as="geometry"/></mxCell><mxCell id="c5" value="Dose (g)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="110" height="16" as="geometry"/></mxCell><mxCell id="c6" value="18" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="110" height="28" as="geometry"/></mxCell><mxCell id="c7" value="Water (ml)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="165" y="56" width="110" height="16" as="geometry"/></mxCell><mxCell id="c8" value="140" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><m
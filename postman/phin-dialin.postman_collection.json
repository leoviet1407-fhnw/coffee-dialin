              "raw": "{\n  \"method\": \"phin\",\n  \"dose_g\": 18,\n  \"water_ml\": 140,\n  \"water_temp_c\": 94,\n  \"drip_time_s\": 190,\n  \"grind_setting\": \"7\",\n  \"taste\": \"sour\"\n}",

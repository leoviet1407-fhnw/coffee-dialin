{
  "info": {
    "name": "PHIN Dial-in API",
    "description": "Every operation of the PHIN Dial-in API with a success and an error case. Start the app (uvicorn dialin_api.main:app --reload), then Run collection: requests are ordered and pass IDs to each other. It creates its own test coffees and deletes them at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = new Date();",
          "pm.collectionVariables.set('today', d.toISOString().slice(0, 10));",
          "pm.collectionVariables.set('nextYear', `${d.getFullYear() + 1}-01-01`);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    }
  ],
  "item": [
    {
      "name": "1 · Products",
      "item": [
        {
          "name": "List the PHIN range",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('three PHIN coffees', () => pm.expect(pm.response.json()).to.have.length(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products",
            "description": ""
          }
        }
      ]
    },
    {
      "name": "2 · Coffees",
      "item": [
        {
          "name": "Add Saigon Drip (PHIN prefill)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Location header', () => pm.response.to.have.header('Location'));",
                  "pm.test('prefilled from PHIN', () => pm.expect(pm.response.json().grams_left).to.eql(250));",
                  "pm.collectionVariables.set('coffee_id', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/coffees",
            "description": "Name, origin, roast level and bag size come from the PHIN product.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"saigon-drip\",\n  \"roast_date\": \"{{today}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Roast date in the future (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('explains the rule', () => pm.expect(pm.response.json().detail).to.include('future'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/coffees",
            "description": "Business rule R2.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"saigon-drip\",\n  \"roast_date\": \"{{nextYear}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Other coffee without details (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/coffees",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kenya AA\",\n  \"roast_date\": \"{{today}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List coffees",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/coffees",
            "description": ""
          }
        },
        {
          "name": "Read the new coffee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/coffees/{{coffee_id}}",
            "description": ""
          }
        },
        {
          "name": "Coffee that does not exist (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('message', () => pm.expect(pm.response.json().detail).to.eql('Coffee 999999 was not found.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/coffees/999999",
            "description": ""
          }
        },
        {
          "name": "New bag: PUT more grams",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('stock updated', () => pm.expect(pm.response.json().grams_left).to.eql(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/coffees/{{coffee_id}}",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Saigon Drip\",\n  \"origin\": \"100% Vietnamese Robusta\",\n  \"roast_level\": \"dark\",\n  \"roast_date\": \"{{today}}\",\n  \"bag_size_g\": 250,\n  \"grams_left\": 500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3 · Brews",
      "item": [
        {
          "name": "Log a sour, fast Phin brew",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('advice: grind finer', () => pm.expect(pm.response.json().advice.action).to.eql('grind_finer'));",
                  "pm.test('dose subtracted', () => pm.expect(pm.response.json().grams_left).to.eql(482));",
                  "pm.collectionVariables.set('sour_brew_id', pm.response.json().id);"
                ]
              }
            }

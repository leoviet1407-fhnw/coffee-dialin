 135 ml · 93 °C · 4:50 drip · grind 6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="446" width="380" height="56" as="geometry"/></mxCell><mxCell id="c45" value="&lt;i&gt;The button only appears on balanced brews, so a sour or bitter brew cannot become the recipe (422 if sent anyway).&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="520" width="380" height="50" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;F · Delete a brew&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;Delete → confirm → removed, dose returned (204)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="336" width="420" height="32" as="geometry"/></mxCell><mxCell id="c47" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="370" width="420" height="270" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="930" y="400" width="360" height="190" as="geometry"/></mxCell><mxCell id="c49" value="DELETE THIS BREW?" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=14;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="950" y="414" width="300" height="22" as="geometry"/></mxCell><mxCell id="c50" value="Brew #2 (18 g) is removed from the log and &lt;b&gt;18 g are returned&lt;/b&gt; to stock." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="450" width="320" height="50" as="geometry"/></mxCell><mxCell id="c51" value="DELETE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="950" y="530" width="110" height="30" as="geometry"/></mxCell><mxCell id="c52" value="Keep" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1080" y="530" width="100" height="30" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;G · Coffee not found&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;open a coffee that does not exist → 404&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="666" width="420" height="32" as="geometry"/></mxCell><mxCell id="c54" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="420" height="270" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;We couldn't find this coffee.&lt;/b&gt;&lt;br&gt;It may have been deleted." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="380" height="100" as="geometry"/></mxCell><mxCell id="c56" value="&lt;u&gt;← Back to your coffees&lt;/u&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="380" height="20" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;H · First brew&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;new coffee, no brews yet&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="460" y="666" width="420" height="32" as="geometry"/></mxCell><mxCell id="c58" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="460" y="700" width="420" height="270" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Phin recipe&lt;/b&gt;&lt;br&gt;No recipe yet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="480" y="720" width="380" height="44" as="geometry"/></mxCell><mxCell id="c60" value="No brews yet.&lt;br&gt;&lt;br&gt;Start with PHIN's guide: &lt;b&gt;18 g · 130 ml · 93 °C · 4–6 min&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" par